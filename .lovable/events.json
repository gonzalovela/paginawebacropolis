    "project.recommendation_requested": {
      "event_schema_version": 1,
      "description": "Visitor asked the advisor for a recommendation.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "used_example"
